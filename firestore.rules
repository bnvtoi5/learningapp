rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Classrooms
    match /classrooms/{classroomId} {
      allow read: if true;
      allow write: if true; // Managed by teacher
    }

    // Topics
    match /topics/{topicId} {
      allow read: if true;
      allow write: if true; // Managed by teacher
    }

    // Lessons
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if true; // Managed by teacher
    }

    // Exercises
    match /exercises/{exerciseId} {
      allow read: if true;
      allow write: if true; // Managed by teacher
    }

    // Users
    match /users/{userId} {
      allow read: if true;
      allow write: if true; // User registration & teacher management
    }

    // Error Logs (Student error notebook)
    match /errors/{errorId} {
      allow read: if true;
      allow write: if true; // Students log their errors and retries
    }

    // Daily Pending Error Reports (Chốt sổ lỗi sau 23:59)
    match /pending_errors/{reportId} {
      allow read, write: if true; // Teachers monitor and students sync incomplete reports
    }

    // Media library (Audio and Images)
    match /media/{mediaId} {
      allow read: if true;
      allow write: if true; // Teachers upload media
    }

    // Media folders
    match /media_folders/{folderId} {
      allow read, write: if true;
    }

    // User personal settings & Mascot personality prompts
    match /user_settings/{userId} {
      allow read, write: if true;
    }

    // Per-user per-lesson progress checkpoints (Auto-Resume)
    match /lesson_progress/{progressId} {
      allow get, delete: if isValidId(progressId);
      allow create, update: if isValidId(progressId)
        && request.resource.data.keys().hasAll(['id', 'userId', 'lessonId', 'currentIndex', 'currentExerciseId', 'totalExercises', 'updatedAt'])
        && request.resource.data.id is string && request.resource.data.id == progressId
        && request.resource.data.userId is string && request.resource.data.userId.size() <= 128
        && request.resource.data.lessonId is string && request.resource.data.lessonId.size() <= 128
        && request.resource.data.currentIndex is number && request.resource.data.currentIndex >= 0
        && request.resource.data.totalExercises is number && request.resource.data.totalExercises >= 0
        && request.resource.data.updatedAt is number;
    }

    // System settings
    match /system_settings/{docId} {
      allow read, write: if true;
    }

    // System connection test doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
